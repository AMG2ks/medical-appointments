# French translations of the MedApp backend (source strings are English).
# Edit with `python manage.py makemessages -l fr`, then `compilemessages`; commit .po AND .mo.
msgid ""
msgstr ""
"Project-Id-Version: medical-appointments\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# --- core ---
msgid "Invalid input."
msgstr "Données invalides."

# --- accounts: API messages ---
msgid "The date of birth cannot be in the future."
msgstr "La date de naissance ne peut pas être dans le futur."

msgid "Only patients have this profile."
msgstr "Seuls les patients ont ce profil."

msgid "A user with this email already exists."
msgstr "Un utilisateur avec cet e-mail existe déjà."

msgid "Invalid email or password."
msgstr "E-mail ou mot de passe incorrect."

msgid "Malformed token."
msgstr "Jeton mal formé."

msgid "The current password is wrong."
msgstr "Le mot de passe actuel est incorrect."

msgid "You cannot deactivate your own account."
msgstr "Vous ne pouvez pas désactiver votre propre compte."

msgid "Invalid or expired code."
msgstr "Code invalide ou expiré."

msgid "If an account exists for this email, a code was sent."
msgstr "Si un compte existe pour cet e-mail, un code a été envoyé."

# --- accounts: emails ---
msgid "Your MedApp code"
msgstr "Votre code MedApp"

msgid "Welcome to MedApp"
msgstr "Bienvenue sur MedApp"

msgid "Hello %(name)s,"
msgstr "Bonjour %(name)s,"

msgid "Your MedApp password reset code is: %(code)s"
msgstr "Votre code de réinitialisation de mot de passe MedApp est : %(code)s"

msgid "It expires in %(minutes)s minutes and can be used only once."
msgstr "Il expire dans %(minutes)s minutes et ne peut être utilisé qu'une seule fois."

msgid "If you did not ask for this, you can ignore this email."
msgstr "Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet e-mail."

msgid "An administrator created a doctor account for you on MedApp."
msgstr "Un administrateur vous a créé un compte médecin sur MedApp."

msgid "Your invitation code is: %(code)s"
msgstr "Votre code d'invitation est : %(code)s"

msgid ""
"In the app, open \"Forgot password\", choose \"I already have a code\" and "
"enter this code with your email to set your password. The code is valid for "
"%(hours)s hours and can be used only once."
msgstr ""
"Dans l'application, ouvrez « Mot de passe oublié », choisissez « J'ai déjà "
"un code » et saisissez ce code avec votre e-mail pour définir votre mot de "
"passe. Le code est valable %(hours)s heures et ne peut être utilisé qu'une "
"seule fois."

# --- doctors: API messages ---
msgid "This specialty is used by doctors."
msgstr "Cette spécialité est utilisée par des médecins."

msgid "This period overlaps an existing availability."
msgstr "Cette plage chevauche une disponibilité existante."

msgid "The end must be after the start."
msgstr "La fin doit être après le début."

# --- appointments: API messages ---
msgid "This slot is already taken."
msgstr "Ce créneau est déjà pris."

msgid "This doctor does not exist."
msgstr "Ce médecin n'existe pas."

msgid "This time is not available for booking."
msgstr "Cet horaire n'est pas disponible à la réservation."

msgid "This appointment cannot change to that status."
msgstr "Ce rendez-vous ne peut pas passer à ce statut."

msgid "It is too late to cancel this appointment."
msgstr "Il est trop tard pour annuler ce rendez-vous."

msgid "This field may not be blank."
msgstr "Ce champ ne peut pas être vide."

msgid "Appointments are already booked during this period."
msgstr "Des rendez-vous sont déjà réservés sur cette période."

msgid "You already have an appointment at that time."
msgstr "Vous avez déjà un rendez-vous à cet horaire."

msgid "You already have an upcoming appointment with this doctor."
msgstr "Vous avez déjà un rendez-vous à venir avec ce médecin."

msgid "You have reached the maximum number of upcoming appointments."
msgstr "Vous avez atteint le nombre maximal de rendez-vous à venir."

msgid "Account deactivated by an administrator."
msgstr "Compte désactivé par un administrateur."

msgid "Enter a valid date."
msgstr "Saisissez une date valide."

# --- notifications: emails ---
msgid "Appointment confirmed"
msgstr "Rendez-vous confirmé"

msgid "New appointment booked"
msgstr "Nouveau rendez-vous réservé"

msgid "Appointment cancelled"
msgstr "Rendez-vous annulé"

msgid "Appointment reminder"
msgstr "Rappel de rendez-vous"

msgid "Hello Dr %(name)s,"
msgstr "Bonjour Dr %(name)s,"

msgid "Your appointment with Dr %(doctor_name)s is confirmed for %(when)s."
msgstr "Votre rendez-vous avec le Dr %(doctor_name)s est confirmé pour le %(when)s."

msgid "%(patient_name)s booked an appointment with you for %(when)s."
msgstr "%(patient_name)s a réservé un rendez-vous avec vous pour le %(when)s."

msgid "%(patient_name)s cancelled the appointment planned for %(when)s."
msgstr "%(patient_name)s a annulé le rendez-vous prévu le %(when)s."

msgid "The clinic cancelled your appointment with %(patient_name)s planned for %(when)s."
msgstr "Le cabinet a annulé votre rendez-vous avec %(patient_name)s prévu le %(when)s."

msgid "Dr %(doctor_name)s cancelled your appointment planned for %(when)s."
msgstr "Le Dr %(doctor_name)s a annulé votre rendez-vous prévu le %(when)s."

msgid "The clinic cancelled your appointment with Dr %(doctor_name)s planned for %(when)s."
msgstr "Le cabinet a annulé votre rendez-vous avec le Dr %(doctor_name)s prévu le %(when)s."

msgid "Reason given by %(reason_by)s: \"%(reason)s\""
msgstr "Motif indiqué par %(reason_by)s : « %(reason)s »"

msgid "the patient"
msgstr "le patient"

msgid "the doctor"
msgstr "le médecin"

msgid "the clinic"
msgstr "le cabinet"

msgid "Reminder: you have an appointment with Dr %(doctor_name)s on %(when)s."
msgstr "Rappel : vous avez un rendez-vous avec le Dr %(doctor_name)s le %(when)s."

# --- accounts / appointments: later additions ---
msgid "The doctor's account was deactivated by an administrator."
msgstr "Le compte du médecin a été désactivé par un administrateur."

msgid "Enter a valid name."
msgstr "Saisissez un nom valide."
