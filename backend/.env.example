DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://medapp:medapp@localhost:5432/medapp
POSTGRES_USER=medapp
POSTGRES_PASSWORD=medapp
POSTGRES_DB=medapp
APP_TIME_ZONE=Africa/Tunis
# auth (M1)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_INVITE_CODE_TTL_HOURS=72
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_CONFIRM=20/hour
THROTTLE_APPOINTMENT_WRITE=20/hour    # POST appointments/ and cancel/ (M3), per user
THROTTLE_APPOINTMENT_CANCEL=10/day    # patient cancellations only (each one emails the doctor), per user
RESET_MAX_FAILED_ATTEMPTS_PER_DAY=10
DJANGO_ADMIN_ENABLED=False
SEED_DEMO_PASSWORD=
# email (M1 + M4) -> Mailpit
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=MedApp <no-reply@medapp.local>
# appointments (M3)
BOOKING_HORIZON_DAYS=30
BOOKING_MIN_LEAD_MINUTES=60
CANCELLATION_MIN_HOURS=24
MAX_UPCOMING_APPOINTMENTS_PER_PATIENT=5
# notifications (M4)
NOTIFICATION_POLL_SECONDS=30     # worker loop period (manage.py run_notification_worker)
NOTIFICATION_MAX_ATTEMPTS=5      # email tries before a notification is marked failed
NOTIFICATION_RETENTION_DAYS=90  # read notifications older than this are purged by the worker
REMINDER_MINUTES_BEFORE=1440     # reminder row/email this long before the start (mobile env: same value)
# Optional host-port overrides are NOT read from this file: compose reads them from the shell
# or a root-level .env (gitignored), e.g. DB_PORT=55432 (then also change the port in DATABASE_URL).
# Keys: DB_PORT (default 5432), MAIL_SMTP_PORT (1025), MAIL_UI_PORT (8025).
